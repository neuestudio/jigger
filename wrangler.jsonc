{
  // Jigger를 Cloudflare Workers(정적 파일 + 주소 정리용 작은 Worker)로 배포하는 설정
  // 배포: npx wrangler deploy   (올릴 파일에서 뺄 것은 .assetsignore)
  "name": "jigger",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  // 예전 주소 jigger.swimguide.workers.dev 로 들어오면 jiggerbar.com 으로 넘기기 위해 켜 둬요
  "workers_dev": true,
  "routes": [
    { "pattern": "jiggerbar.com", "custom_domain": true },
    { "pattern": "www.jiggerbar.com", "custom_domain": true }
  ],
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    // Worker는 HTML · API에만 돌려요. 이미지 · 글꼴 · CSS · JS 같은 정적 파일은 Worker를 거치지 않아
    // 무료 요청 한도(하루 10만 회)를 쓰지 않아요. 이 파일들의 보안 헤더는 _headers에서 붙여요.
    "run_worker_first": [
      "/*",
      "!/images/*", "!/fonts/*", "!/tasting/assets/*", "!/party/assets/*",
      "!/page.css", "!/data.js", "!/photos.js", "!/affiliate.js", "!/quiz-questions.js",
      "!/favicon.svg", "!/favicon.ico", "!/apple-touch-icon.png", "!/og.jpg",
      "!/robots.txt", "!/sitemap.xml", "!/rss.xml"
    ]
  },
  "vars": {
    "CANONICAL_HOST": "jiggerbar.com",
    // 문의폼 메일: jiggerbar.com Email Routing으로 보내고, 받는 주소는 Cloudflare에서 인증된 주소여야 해요
    "CONTACT_FROM": "contact@jiggerbar.com",
    "CONTACT_TO": "jiggerbar.info@gmail.com"
  },
  "send_email": [{ "name": "MAILER", "destination_address": "jiggerbar.info@gmail.com" }],
  // 테이스팅 노트: 리뷰는 D1, 사진은 R2 (migrations/0001_tasting.sql)
  // 관리자 비밀번호와 로그인 서명 키는 비밀값으로: npx wrangler secret put ADMIN_PASSWORD / SESSION_SECRET
  "d1_databases": [
    { "binding": "DB", "database_name": "jigger-tasting", "database_id": "23414cdc-89ff-474b-bdbb-e1ecd7b92cd7" }
  ]
  // 사진(R2)은 계정에서 R2를 켠 뒤 연결해요: npx wrangler r2 bucket create jigger-tasting-photos 후 아래 주석을 풀어 주세요.
  // 연결 전에는 관리자 화면에서 사진 칸이 숨겨지고, 리뷰는 사진 없이 저장돼요.
  // "r2_buckets": [
  //   { "binding": "PHOTOS", "bucket_name": "jigger-tasting-photos" }
  // ]
}
